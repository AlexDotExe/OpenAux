# Force the deterministic in-repo fake music provider for credential-less testing only.
MUSIC_PROVIDER_FAKE=0

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us
TOKEN_ENCRYPTION_KEY=

# Spotify search page size ceiling. Spotify documents a max of 50, but restricted
# app tiers reject limits above 10 with 400 "Invalid limit". Default 10 is safe
# everywhere; raise it if your app has full catalog access.
SPOTIFY_SEARCH_MAX_LIMIT=10
