# Force the deterministic in-repo fake music provider for credential-less testing only.
MUSIC_PROVIDER_FAKE=0

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us
TOKEN_ENCRYPTION_KEY=

# Spotify search page size ceiling. Spotify documents a max of 50, but restricted
# app tiers reject limits above 10 with 400 "Invalid limit". Default 10 is safe
# everywhere; raise it if your app has full catalog access.
SPOTIFY_SEARCH_MAX_LIMIT=10

# Sign in with Google / Apple (SPEC.md §2). ID tokens are verified against the
# provider's JWKS with the audience pinned to these ids. Leave blank to disable a
# provider — with neither set, authToken joins are rejected and only guest joins work.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# Browser-side Google client id for the patron sign-in button (same id as GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# How often to poll Spotify for end-of-track (ms). This interval is the window in
# which Spotify's autoplay can play something the crowd didn't pick, so lower is
# tighter — at the cost of more Spotify API calls per venue. Default 2000.
SPOTIFY_POLL_INTERVAL_MS=2000

# How long before a song ends to lock in the crowd's next pick and prime the
# device, so the handover is gapless (ms). Longer = safer handover but the queue
# stops re-ranking earlier. Default 10000.
NEXT_SONG_LOCK_LEAD_MS=10000
